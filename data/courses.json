  {
    "code": "062074",
    "name": "VEHICLE ACOUSTICS",
    "reviews": [
      {
        "teacher": "",
        "author": "",
        "semester": "2025 秋",
        "overallScore": 5,
        "content": {
          "score": 5,
          "review": "课程设置的很好，概括很全。三个实验很有意思，老师是Bovisa那边的，认真负责。如果对车辆声学感兴趣的话强烈推荐去选，口试难度不是特别大，但确实要认真去复习每个模块，老师口试的时候会问的很细致。"
        },
        "assessment": {
          "score": 5,
          "review": "口试加三个实验和一篇论文，其实难度不是特别大，但PPT尤其重要，难度很大的公式可以不用管，但是对于原理和模拟要很熟悉，不能半桶水，老师一问就露馅。实验要好好做，实验自己做的PPT也要很熟。"
        },
        "instructor": {
          "score": 5,
          "review": "两个老师都很好，一个管实验一个管理论，有什么不懂的老师都会很认真回复你。"
        },
        "notes": "",
        "updatedAt": "2026-08-09"
